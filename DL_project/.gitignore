# Scheduler artifacts: per-cluster job queues and session markers are runtime
# state created on the cluster, not source. They were tracked before the Kraken
# port; `git rm -r --cached` was used to untrack them without deleting them.
.bigfoot_job_queue/
.bigfoot_job_queues/
.kraken_job_queues/
.bigfoot_session_*
.kraken_session_*
OAR.*.stdout
OAR.*.stderr

__pycache__/
*.pyc

# Timestamped safety copies of the metrics table.
metrics_summary.csv.bak_*

# Training results: produced on clusters and synced back locally, not tracked.
# Including them in git blocks rsync to remote clusters (git sees them as modified
# and rsync tries to transfer them even though cluster_sync_excludes.sh lists them).
run/
models/
test_metrics/
# graphics/
script_logs/

# torch.profiler traces from scripts/profile_training.py: large, timestamped,
# and reproducible from source -- not worth tracking.
profiler_runs/

# ESM3 checkpoint cache (5.2 GB): downloaded by
# preprocessing/embed_protein_esm3_v2.py from EvolutionaryScale/esm3-sm-open-v1,
# reproducible at any time, see preprocessing/EXTERNAL_TOOLS.md.
data/esm3_checkpoint/

# flock targets: analysis/build_metrics_table.py creates <table>.lock on the fly to
# serialise concurrent writers of metrics_summary.csv. Always empty, recreated on
# demand, meaningless outside the moment it is held.
*.lock

# analysis/chemistry_null_model.py's persisted null-model results (--label), rebuilt
# on demand from data/ -- not source, and would otherwise look like an uncommitted
# change on every run that adds a new (label, family, seed) entry.
analysis/.null_model_cache.json

# Generated stores above GitHub's 100 MB per-file limit: pushing them is rejected
# outright, so they stay local. All are rebuildable from source -- the Tanimoto
# matrix from preprocessing/build_tanimoto_matrix.py (a compact form is tracked as
# data/Tanimoto_compact_*, built by preprocessing/build_tanimoto_compact.py), the
# embedding stores from
# data/build_lipid_embedding_store.py.
data/Total_tanimoto_matrix_uint8.npy
data/lipid_SMILES_embedding_deterministic.pkl
data/lipid_SMILES_embedding_deterministic.tensors.pt
data/isomeric_lipids/lipid_SMILES_isomeric_embedding.pkl

# Pretrained MoLFormer checkpoint (1.6 GB unpacked): the source of the lipid
# embedding tables above, unpacked from the distributed zip and read only by
# preprocessing/embed_isomeric_smiles_molformer.py, never by training.
data/Pretrained MoLFormer/

# --testmode redirects every artifact a run writes -- run/, test_metrics/,
# metrics_summary.csv and its analyses -- here (training/new_train.py, artifact_root),
# so a smoke run cannot touch the real tables. Throwaway by construction.
testmode_outputs/
